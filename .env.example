# Copia este archivo a .env.local y pega tu API key.
# El tenant se selecciona en company-twin/runtime.json; estas variables permiten
# sobrescribirlo por despliegue sin editar el repo.
# AI_GATEWAY_API_KEY: crea una key en https://vercel.com/dashboard -> AI Gateway.
# El agente (agent/agent.ts) enruta el modelo por Vercel AI Gateway, ya NO llama
# a Anthropic directo. ANTHROPIC_API_KEY queda sin uso salvo que se revierta el cambio.
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
SIGMA_TENANT=icf
INTELISIS_MCP_URL=
