	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "rm -f .eve/sveltekit-dev-server.json && unset npm_config_prefix && . ~/.nvm/nvm.sh && nvm use 24 && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
